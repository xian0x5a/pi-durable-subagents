{
  "name": "@xian0x5a/pi-durable-subagents",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Durable Pi agents that collaborate asynchronously under explicit Owner and Spawner supervision.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xian0x5a/pi-durable-subagents.git"
  },
  "homepage": "https://github.com/xian0x5a/pi-durable-subagents#readme",
  "bugs": {
    "url": "https://github.com/xian0x5a/pi-durable-subagents/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md",
    "docs/images/*.png",
    "docs/images/*.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/xian0x5a/pi-durable-subagents/main/docs/images/agent-switcher.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "benchmark:attached-terminal": "node benchmarks/attached-terminal-output.ts",
    "test": "npm run test:fast && npm run test:process",
    "test:fast": "node tests/support/run-test-suite.ts fast",
    "test:ci": "node tests/support/run-test-suite.ts fast --test-timeout=15000 --deadline-ms=480000",
    "test:process": "node tests/support/run-test-suite.ts process",
    "test:conformance": "node tests/support/run-test-suite.ts conformance",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.99.0",
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "24.10.1",
    "typebox": "1.3.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.2.0-beta.15",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "node-pty": true
  }
}
